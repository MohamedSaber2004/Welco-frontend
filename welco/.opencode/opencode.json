{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask"
  },
  "mcp": {
    "servers": {
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "oauth": false,
        "headers": {
          "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
        }
      }
    }
  }
}