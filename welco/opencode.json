{
  "$schema": "https://opencode.ai/config.json",
  "model": "agentrouter/deepseek-v4-flash",
  "permission": {
    "edit": "ask"
  },
  "plugin": [
    "file:///C:/Users/ALQasem/.config/opencode/plugins/agentrouter-headers.js"
  ],
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "i18n": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "i18n-mcp",
        "--dir",
        "./src/i18n",
        "--base-language",
        "en",
        "--src-dir",
        "./src",
        "--project-root",
        ".",
        "--exclude",
        "node_modules,dist,.git",
        "--frameworks",
        "vue",
        "--key-style",
        "nested"
      ],
      "enabled": true
    }
  },
  "provider": {
    "seekai": {
      "name": "SeekAI",
      "npm": "@ai-sdk/openai-compatible",
      "env": [
        "SEEKAI_API_KEY"
      ],
      "options": {
        "baseURL": "https://seekai.cc/v1"
      },
      "models": {
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7"
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6"
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 SOL"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        }
      }
    },
    "agentrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter",
      "env": [
        "AGENTROUTER_API_KEY"
      ],
      "options": {
        "baseURL": "https://agentrouter.org/v1",
        "headers": {
          "User-Agent": "claude-cli/1.0.108 (external, cli)",
          "anthropic-version": "2023-06-01",
          "X-Title": "Roo Code",
          "HTTP-Referer": "https://github.com/RooVetGit/Roo-Cline"
        }
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "glm-5.3": {
          "name": "GLM 5.3"
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 SOL"
        }
      }
    },
    "naraya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaraRouter",
      "env": [
        "BYNARA_API_KEY"
      ],
      "options": {
        "baseURL": "https://router.bynara.id/v1"
      },
      "models": {
        "agnes-2.0-flash": {
          "name": "Agnes 2.0 Flash"
        }
      }
    }
  }
}